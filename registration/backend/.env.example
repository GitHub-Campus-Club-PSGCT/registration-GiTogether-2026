# Copy this to .env. Both local runs and Docker read their settings from it.

# Your MongoDB connection string. This one is for MongoDB running on your machine, so use your Atlas one in Docker.
MONGODB_URI=mongodb://127.0.0.1:27017/gitogether

# Set to false to close registration.
REGISTRATION_OPEN=true

# The password for /gitogether2026/admin. Use something long.
ADMIN_PASSWORD=choose-a-long-password

# Set to true to send emails. When it's on, every team you register emails real college addresses,
# so locally, only use real roll numbers you own.
SEND_EMAILS=false

# Your email login. Nothing is sent unless SEND_EMAILS is true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ghcc.club@psgtech.ac.in
SMTP_PASS=your-app-password-without-spaces
